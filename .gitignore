# 파이썬
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 환경 변수 (API 키 등) — 절대 커밋 금지
.env

# 큰 데이터: 논문 원본 코퍼스, 임베딩, 검색 결과 캐시
# (평가셋 data/eval/ 과 샘플 data/sample/ 은 커밋해서 재현 가능하게 둔다)
data/corpus/
data/embeddings/
data/API_KEY.env

# runs/ = 굴러가며 나오는 임시 실험 결과 (버려도 됨)
# results/ = 보고서에 인용하는 확정 결과 → 커밋해서 재현·검증 가능하게 둔다
runs/
*.faiss

# OS / 에디터
.DS_Store
.idea/
.vscode/
# 학습된 모델 가중치 — git이 아니라 HuggingFace Hub로 배포한다
# (LoRA 어댑터 264MB + optimizer 528MB × 체크포인트 수 = 저장소가 GB 단위로 불어난다)
models/

# arXiv 검색 결과 캐시 — 재생성 가능하고 계속 커진다
data/cache/

logs/
